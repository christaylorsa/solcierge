# ---------------------------------------------------------------------------
# Solcierge environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. SERVER ONLY. Every write in this app goes through route
# handlers using this key; RLS denies anon access outright.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Solana ---------------------------------------------------------------
# Treasury wallet that receives SOL and USDC. Base58 public key.
NEXT_PUBLIC_TREASURY_WALLET=SoLcierGeTreasury11111111111111111111111111

# RPC endpoint. The public endpoints are rate limited; use Helius/Triton/QuickNode
# in production. NEXT_PUBLIC_ one is used by the browser to send transactions,
# SOLANA_RPC_URL is used server-side for verification (can be a private URL).
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# mainnet-beta | devnet | testnet — drives explorer links and the default USDC mint.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# USDC SPL mint.
#   mainnet-beta: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
#   devnet:       4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# --- Sessions & admin -----------------------------------------------------
# Random 32+ char secret used to sign the wallet session JWT.
#   openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-long-random-string

# Comma-separated wallet addresses allowed into /admin.
ADMIN_WALLETS=
# Comma-separated emails allowed into /admin (for the email-auth fallback).
ADMIN_EMAILS=

# --- Pricing --------------------------------------------------------------
# jupiter | coingecko — primary source for the SOL/USD rate. The other is used
# as the fallback automatically.
PRICE_SOURCE=jupiter
# Optional CoinGecko Pro key. Leave blank to use the free public endpoint.
COINGECKO_API_KEY=

# How long a locked pay-time rate stays valid, in seconds.
RATE_LOCK_SECONDS=600

# --- Operator alerts ---------------------------------------------------
# Optional. Each channel is skipped when its variables are empty.
# Telegram: create a bot with @BotFather, then message it once to get your chat id.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids (a person, or a group the bot has been added to).
# The same bot sends members their booking updates once they tap "Connect
# Telegram"; its webhook registers itself, using a secret derived from SESSION_SECRET.
TELEGRAM_CHAT_IDS=
# Email via Resend (resend.com). The ALERT_FROM domain must be verified there.
RESEND_API_KEY=
ALERT_EMAILS=
ALERT_FROM=Solcierge Desk <desk@solcierge.xyz>

# --- Connect X (optional) ------------------------------------------------
# An OAuth 2.0 app from console.x.com, type "Web App" (confidential client), with
# the callback URL set to <NEXT_PUBLIC_SITE_URL>/api/x/callback. X bills each
# profile read against prepaid credits. Leave both empty to hide the button.
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
